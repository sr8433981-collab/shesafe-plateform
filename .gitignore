# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Runtime data (SQLite + WAL sidecars). The database is created on first run
# and must never be committed: it contains emergency records and share tokens.
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.sqlite3

# Node (no runtime dependencies, but keep tooling artefacts out)
node_modules/
npm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editors & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp