# SheSafe environment configuration
#
# Copy to `.env` for local use, or export these in your shell. NEVER commit a
# filled-in .env. Every value here has a safe development default, so the app
# runs with no configuration at all.

# --- core -------------------------------------------------------------------
# development | production | testing
SHESAFE_ENV=development
HOST=127.0.0.1
PORT=5000

# REQUIRED in production. A random 32-byte hex string is fine:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset in development, a stable per-machine key is derived so a demo session
# survives a restart. Production refuses to start without this value.
SHESAFE_SECRET_KEY=

# --- database ---------------------------------------------------------------
# SQLite file. Created automatically with schema migrations applied.
SHESAFE_DB=backend/data/shesafe.db

# --- demo mode --------------------------------------------------------------
# 1 enables the clearly-labelled Demo Mode used for hackathon presentations.
# When off, every /api/demo/* route returns 404.
SHESAFE_DEMO_MODE=0

# --- security ---------------------------------------------------------------
# Comma-separated origins allowed to make credentialed requests.
SHESAFE_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Set to 1 behind a trusted reverse proxy so X-Forwarded-For is honoured.
SHESAFE_TRUST_PROXY=0
SHESAFE_SECURE_COOKIES=0
SHESAFE_HSTS=0

# --- retention --------------------------------------------------------------
# Days to keep non-incident location samples. Incident trails are kept for the
# life of the incident record.
SHESAFE_LOCATION_RETENTION_DAYS=30
SHESAFE_SHARE_TTL=3600
SHESAFE_SHARE_TTL_MAX=86400

# --- notification providers -------------------------------------------------
# Without credentials these report `unavailable`/`simulated` honestly. The UI
# never claims a message was sent unless a provider confirmed it.
SHESAFE_SMS_PROVIDER=none          # none | twilio | msg91
SHESAFE_SMS_ACCOUNT_SID=
SHESAFE_SMS_AUTH_TOKEN=
SHESAFE_SMS_FROM=
SHESAFE_MSG91_AUTH_KEY=
SHESAFE_MSG91_SENDER_ID=
SHESAFE_WHATSAPP_PROVIDER=none     # none | twilio
SHESAFE_PUSH_PROVIDER=none         # none | fcm
SHESAFE_FCM_SERVER_KEY=

# --- AI (advisory only, never gates SOS) ------------------------------------
# With no provider configured, the transparent rule-based classifier is used.
SHESAFE_AI_PROVIDER=none            # none | openai_compatible
SHESAFE_AI_ENDPOINT=
SHESAFE_AI_MODEL=
SHESAFE_AI_API_KEY=

# --- external data providers ------------------------------------------------
SHESAFE_ROUTING_PROVIDER=osrm
SHESAFE_PLACES_PROVIDER=overpass
SHESAFE_OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
SHESAFE_PLACES_CACHE_TTL=900
SHESAFE_HTTP_TIMEOUT=8

# --- observability ----------------------------------------------------------
SHESAFE_LOG_LEVEL=INFO
SHESAFE_LOG_JSON=1