{
  "name": "SheSafe — Personal Safety & Emergency Response",
  "short_name": "SheSafe",
  "description": "One-press SOS with a cancel window, live location sharing with expiring revocable links, explainable safety scoring and safety-aware routing.",
  "start_url": "./index.html",
  "scope": "./",
  "id": "/shesafe",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#f6f7fb",
  "theme_color": "#4f46e5",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "lifestyle", "medical", "security"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Dashboard and SOS", "short_name": "SOS", "url": "./index.html#/home", "description": "Open the dashboard and raise an emergency" },
    { "name": "Live location", "short_name": "Live", "url": "./index.html#/sharing", "description": "Start live location sharing with an expiring link" },
    { "name": "Journey Guard", "short_name": "Journey", "url": "./index.html#/journey", "description": "Start a watched journey" },
    { "name": "Emergency numbers", "short_name": "112", "url": "./offline.html", "description": "Emergency numbers that work without a connection" }
  ]
}
